{
    "scripts": {
        "start": "react-native start",
        "android": "react-native run-android",
        "ios": "react-native run-ios",
        "web": "expo start --web",
        "dev": "cd web-bundler && DEV_HTTPS=1 npm run dev",
        "web-webpack": "npm run dev",
        "web-webpack-https": "npm run dev",
        "svg": "npx @svgr/cli -d assets/svg/LandingPage/experiment assets/svg/LandingPage/experiment",
        "build-web": "expo build:web",
        "build-web-webpack": "cd web-bundler && npm run build",
        "test": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 jest",
        "update-snapshots": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 jest -u",
        "coverage": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 jest --coverage",
        "test:firestore-rules": "node ci/check-firestore-rule-coverage.js && TZ=UTC firebase emulators:exec --only firestore --project demo-alldone-rules \"jest __tests__/Firestore/firestoreRules.emulator.test.js --runInBand\"",
        "start-clean": "react-native start --reset-cache",
        "format-code": "prettier --write --ignore-unknown .",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=22"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "transform": {
            "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
        },
        "haste": {
            "defaultPlatform": "web",
            "platforms": [
                "web"
            ]
        },
        "coveragePathIgnorePatterns": [
            "utils/BackendBridge.js",
            "utils/backends/rtdb.js",
            "utils/backends/firestore.js",
            "utils/backends/firebasemock.js",
            "assets/svg/*",
            "components/WorkflowModal/WorkflowModal.js",
            "components/Feeds/CommentsTextInput/WrapperMentionsModal.js"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!(quill[^/]*|parchment|react-quill-new|lodash-es|lib0|y-quill|y-protocols|y-websocket|y-indexeddb|yjs|react-native[^/]*|expo[^/]*|@expo|@react-native|@react-navigation|@unimodules)/)"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/.claude/"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 10,
                "functions": 10,
                "lines": 10,
                "statements": 10
            }
        },
        "setupFiles": [
            "./ci/jestPolyfills.js",
            "./node_modules/react-native-gesture-handler/jestSetup.js"
        ],
        "setupFilesAfterEnv": [
            "./ci/jestSetup.js"
        ],
        "moduleNameMapper": {
            "\\.(css|less|scss)$": "<rootDir>/__mocks__/styleMock.js",
            "\\.(png|jpg|jpeg|gif|webp|svg|ttf|otf|woff2?|mp4|webm|mp3|wav)$": "<rootDir>/__mocks__/assetMock.js",
            "^firebase-admin/(.*)$": "<rootDir>/functions/node_modules/firebase-admin/lib/$1",
            "^firebase-functions/v2/(.*)$": "<rootDir>/functions/node_modules/firebase-functions/lib/v2/providers/$1",
            "^firebase-functions/(logger|params)$": "<rootDir>/functions/node_modules/firebase-functions/lib/$1/index.js"
        },
        "testPathIgnorePatterns": [
            "/node_modules/",
            "<rootDir>/.claude/",
            "<rootDir>/functions/",
            "<rootDir>/cloudflare/",
            "__tests__/TwilioWhatsAppService.test.js",
            "__tests__/Chats/copyChatToOtherProject.test.js",
            "__tests__/Feeds/copyInnerFeedsToOtherProject.test.js",
            "__tests__/SidebarMenu/UserItem.test.js",
            "__tests__/LandingPage/Imprint.test.js",
            "__tests__/ContactDetailedView/ContactDetailedView.test.js",
            "__tests__/ContactDetailedView/Header/Header.test.js",
            "__tests__/SettingsView/Header/SettingsHeader.test.js",
            "__tests__/SettingsView/SettingsView.test.js",
            "__tests__/SettingsView/Header/BackButton.test.js",
            "__tests__/TaskDetailedView/TaskDetailedView.test.js",
            "__tests__/TaskDetailedView/Header/BackButton.test.js",
            "__tests__/TaskDetailedView/Header/Header.test.js",
            "__tests__/ProjectDetailedView/Header/Header.test.js",
            "__tests__/ProjectDetailedView/Header/Backbutton.test.js",
            "__tests__/ProjectDetailedView/ProjectDetailedView.test.js",
            "__tests__/UserDetailedView/BackButton.test.js",
            "__tests__/UserDetailedView/Header.test.js",
            "__tests__/UserDetailedView/UserDetailedView.test.js",
            "__tests__/TaskDetailedView/Properties/Privacy.test.js",
            "__tests__/TaskListView/PendingTasksView/PendingTasksView.test.js",
            "__tests__/WorkflowModal/WorkflowModal.test.js",
            "__tests__/URLSystem/Contacts/URLsContactsTrigger.test.js",
            "__tests__/WorkflowModal/WorkflowSelection.test.js",
            "__tests__/ProjectLabel.test.js"
        ],
        "globals": {
            "window": {}
        }
    },
    "dependencies": {
        "@babel/runtime": "^7.29.7",
        "@hello-pangea/dnd": "^18.0.1",
        "@ipregistry/client": "^4.5.0",
        "@manaflair/redux-batch": "1.0.0",
        "@react-native-async-storage/async-storage": "1.15.14",
        "@react-native-community/google-signin": "4.0.0",
        "@react-native-community/masked-view": "0.1.7",
        "@sentry/react": "^10.69.0",
        "@types/jest": "25.1.2",
        "@types/react": "16.9.27",
        "@types/react-native": "0.61.12",
        "chart.js": "^3.9.1",
        "chartjs-adapter-moment": "^1.0.1",
        "chartjs-plugin-datalabels": "^2.2.0",
        "expo": "36.0.0",
        "fbjs": "3.0.0",
        "firebase": "12.17.1",
        "i18n-js": "3.9.2",
        "isomorphic-fetch": "^3.0.0",
        "lodash": "4.17.21",
        "lottie-react": "2.2.1",
        "moment": "2.30.1",
        "moment-timezone": "0.5.34",
        "prop-types": "15.7.2",
        "quill": "2.0.3",
        "quill-cursors": "5.0.0",
        "quill-delta": "5.1.0",
        "quill-delta-to-html": "0.12.0",
        "quill-drag-and-drop-module": "0.3.0",
        "react": "^18.3.1",
        "react-chartjs-2": "^4.3.1",
        "react-contenteditable": "3.3.5",
        "react-device-detect": "1.13.1",
        "react-dismissible": "1.1.5",
        "react-dom": "^18.3.1",
        "react-hot-keys": "2.7.1",
        "react-native": "0.61.4",
        "react-native-calendars": "^1.1314.0",
        "react-native-dropdown-picker": "^5.4.6",
        "react-native-gesture-handler": "1.5.6",
        "react-native-hyperlink": "0.0.19",
        "react-native-safe-area-context": "3.2.0",
        "react-native-svg": "11.0.1",
        "react-native-web": "^0.21.2",
        "react-native-web-linear-gradient": "1.1.1",
        "react-native-web-webview": "1.0.1",
        "react-quill-new": "3.8.3",
        "react-redux": "^9.3.0",
        "react-tiny-popover": "4.0.0",
        "react-tooltip": "4.2.18",
        "redux": "^5.0.1",
        "tinycolor2": "^1.6.0",
        "y-indexeddb": "^9.0.12",
        "y-quill": "1.0.0",
        "y-websocket": "1.3.17",
        "yjs": "13.6.32"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-proposal-export-default-from": "^7.29.7",
        "@babel/plugin-transform-block-scoping": "^7.29.7",
        "@babel/plugin-transform-class-properties": "^7.29.7",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@babel/plugin-transform-runtime": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-flow": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@expo/webpack-config": "^0.12.38",
        "@firebase/rules-unit-testing": "^5.0.2",
        "@svgr/cli": "^5.4.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/react-native": "^7.0.2",
        "babel-jest": "^30.4.1",
        "babel-preset-expo": "~8.0.0",
        "css-loader": "^5.2.7",
        "firebase-tools": "^13.29.3",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "metro-react-native-babel-preset": "~0.56.0",
        "prettier": "^3.9.6",
        "pretty-quick": "^4.2.2",
        "react-native-dotenv": "^0.2.0",
        "react-native-testing-library": "^2.1.0",
        "react-test-renderer": "^18.3.1",
        "style-loader": "^2.0.0",
        "typescript": "^5.9.3",
        "webpack-bundle-analyzer": "^4.10.2"
    },
    "private": true
}
