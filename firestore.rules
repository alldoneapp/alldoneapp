// Firestore security rules.
//
// These are compiled, behavior-tested and deployed automatically to production by CI
// (`deploy:firestore:rules:production` in .gitlab-ci.yml) when this file changes.
// Before AT-2450 nothing deployed them at all and it was a manual
// `firebase deploy --only firestore:rules`, which is how the file came to describe an
// authorization model production was not actually running.
//
// Two consequences worth keeping in mind when editing:
//   - A merge publishes the rules only after the behavioral emulator suite, the full web
//     suite and the production bundle succeed. A failed gate leaves production unchanged.
//   - A deploy publishes the WHOLE file, never just your hunk, so anything already
//     committed here but not yet released ships alongside your change.
//
// Staging is NOT deployed by CI (`develop` is dormant); publish it by hand if you need
// it: firebase deploy --only firestore:rules --project alldonestaging
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function publicForAll() {
      return 0;
    }

    function privateProject() {
      return 2;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectDocAfter(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId));
    }

    function isProjectMemberBeforeOrAfter(projectId) {
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      let beforeIds = exists(projectPath) ? get(projectPath).data.get('userIds', []) : [];
      let afterIds = existsAfter(projectPath) ? getAfter(projectPath).data.get('userIds', []) : [];
      return signedIn() && (request.auth.uid in beforeIds || request.auth.uid in afterIds);
    }

    function hasValidDefaultProject(userId, userData) {
      return !('defaultProjectId' in userData) ||
        userData.defaultProjectId == '' ||
        (
          userData.defaultProjectId is string &&
          projectDocAfter(userData.defaultProjectId).data.creatorId == userId
        );
    }

    function hasValidInitialProjectMembership(userId, userData) {
      let projectId = userData.get('defaultProjectId', '');
      return projectId is string && projectId != '' &&
        userData.get('projectIds', []).toSet() == [projectId].toSet() &&
        userData.get('guideProjectIds', []).toSet().hasOnly([projectId]) &&
        userData.get('templateProjectIds', []).toSet().hasOnly([projectId]) &&
        userData.get('archivedProjectIds', []).toSet().hasOnly([projectId]) &&
        userData.get('copyProjectIds', []).toSet().hasOnly([projectId]) &&
        userData.get('invitedProjectIds', []).size() == 0 &&
        userId in projectDocAfter(projectId).data.get('userIds', []);
    }

    // users/{uid}.email is the account's login address as Firebase Auth holds it. Other systems
    // received it as the account's identity (alldone.team keys embedded tool data and Gold on
    // it), so an owner may only leave it empty or set it to the address in their own token.
    // Servers read the verified Auth email instead (functions/shared/verifiedAccountEmail.js);
    // this keeps the copy the client shows and forwards honest too.
    function emailMatchesAuthToken(userData) {
      let email = userData.get('email', '');
      return email == '' || email == request.auth.token.get('email', '');
    }

    function ownerUpdateKeepsEmailHonest() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
        emailMatchesAuthToken(request.resource.data);
    }

    // Gold, the daily earning cap, premium status and the Stripe and Mollie customer links are
    // written only by Cloud Functions (gold ledger, premium check, Stripe webhook, Mollie
    // subscription callables). A client that could set them gave itself Gold or premium, or
    // pointed its account at somebody else's Stripe or Mollie customer (security audit 2026-11:
    // createCompanySubscriptionSecondGen reuses the stored Mollie customerId).
    // unlockedKeysByGuides is written by unlockGuideGoalSecondGen in the same transaction as the
    // 80 Gold charge (AT-2978); a client that could add a key unlocked a goal without paying.
    function ownerUpdateKeepsServerFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'gold', 'dailyGold', 'premium', 'stripeCustomerId', 'customerId', 'unlockedKeysByGuides'
      ]);
    }

    // A project membership mutation may drop a project's lock keys (leaving or deleting the project)
    // but never add one (AT-2978).
    function unlockedKeysNotAdded(projectId) {
      let before = resource.data.get('unlockedKeysByGuides', {});
      let after = request.resource.data.get('unlockedKeysByGuides', {});
      let beforeKeys = before is map ? before.get(projectId, []) : [];
      let afterKeys = after is map ? after.get(projectId, []) : [];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlockedKeysByGuides']) ||
        afterKeys == null ||
        (afterKeys is list && beforeKeys is list && afterKeys.toSet().difference(beforeKeys.toSet()).size() == 0);
    }

    // A new account starts with exactly what getNewDefaultUser writes (ContactsHelper.js) or less.
    function newUserHasDefaultServerFields(userData) {
      let gold = userData.get('gold', 0);
      let dailyGold = userData.get('dailyGold', 0);
      return gold is int && gold >= 0 && gold <= 100 &&
        dailyGold is int && dailyGold >= 0 && dailyGold <= 100 &&
        userData.get('premium', {'status': 'free'}) == {'status': 'free'} &&
        userData.get('stripeCustomerId', '') == '' &&
        userData.get('customerId', '') == '' &&
        userData.get('unlockedKeysByGuides', {}) == {};
    }

    // The gold ledger and its idempotency claims are server-written; a client that could write
    // them could forge a charge to refund or delete a claim to collect a reward twice.
    function isServerOwnedUserCollection(collectionName) {
      return collectionName in ['goldTransactions', 'goldRewardClaims', 'goldChangeClaims'];
    }

    function ownerUpdatePreservesProjectMembership() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'projectIds', 'guideProjectIds', 'templateProjectIds',
        'archivedProjectIds', 'copyProjectIds', 'invitedProjectIds',
        'projectMembershipMutation'
      ]);
    }

    function listChangedOnlyByProjectId(beforeList, afterList, projectId) {
      return beforeList.toSet().difference(afterList.toSet()).hasOnly([projectId]) &&
        afterList.toSet().difference(beforeList.toSet()).hasOnly([projectId]);
    }

    function projectMapChangedOnlyAt(fieldName, projectId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get(fieldName, {});
      let after = request.resource.data.get(fieldName, {});
      // Some long-lived and freshly-created users legitimately store nullable project maps
      // (notably apisConnected: null). A project membership update that leaves such a field
      // untouched must not try to call map.diff() on null and fail the entire atomic batch.
      return !affected.hasAny([fieldName]) ||
        (before is map && after is map && before.diff(after).affectedKeys().hasOnly([projectId]));
    }

    function projectMapChangedOnlyAtWithGlobal(fieldName, projectId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get(fieldName, {});
      let after = request.resource.data.get(fieldName, {});
      return !affected.hasAny([fieldName]) ||
        (before is map && after is map && before.diff(after).affectedKeys().hasOnly([projectId, 'allProjects']));
    }

    function validFocusChange(userId, projectId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let focusTaskId = request.resource.data.get('inFocusTaskId', '');
      let focusProjectId = request.resource.data.get('inFocusTaskProjectId', '');
      return !affected.hasAny(['inFocusTaskId', 'inFocusTaskProjectId']) ||
        (focusTaskId == '' && focusProjectId == '') ||
        (
          focusTaskId is string && focusTaskId != '' &&
          focusProjectId == projectId &&
          exists(/databases/$(database)/documents/items/$(projectId)/tasks/$(focusTaskId)) &&
          (
            get(/databases/$(database)/documents/items/$(projectId)/tasks/$(focusTaskId)).data.get('userId', '') == userId ||
            userId in get(/databases/$(database)/documents/items/$(projectId)/tasks/$(focusTaskId)).data.get('userIds', []) ||
            userId in get(/databases/$(database)/documents/items/$(projectId)/tasks/$(focusTaskId)).data.get('observersIds', [])
          )
        );
    }

    // security audit 2026-11: an invitation decline/cancel may only drop the invitation. It must
    // never put the project id into a membership list, or any account could add an arbitrary project
    // id to its own projectIds (which the users read rule and older server paths trust).
    function doesNotAddProjectId(fieldName, projectId) {
      return !(projectId in request.resource.data.get(fieldName, [])) ||
        projectId in resource.data.get(fieldName, []);
    }

    // security audit 2026-11 (NV-11 residual): an invitation is one entry in invitedProjectIds. The
    // generic membership allowlist below also admits assistantId, lastEditorId and the assistant
    // comment maps, so without this an inviter could rewrite those on the invitee's user document.
    function onlyInvitationFieldsChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['invitedProjectIds', 'projectMembershipMutation']);
    }

    function isValidProjectMembershipMutation(userId) {
      let mutation = request.resource.data.get('projectMembershipMutation', {});
      let projectId = mutation.get('projectId', '');
      let action = mutation.get('action', '');
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      let projectBefore = exists(projectPath) ? get(projectPath).data.get('userIds', []) : [];
      let projectAfter = existsAfter(projectPath) ? getAfter(projectPath).data.get('userIds', []) : [];
      let membershipFieldsValid =
        listChangedOnlyByProjectId(resource.data.get('projectIds', []), request.resource.data.get('projectIds', []), projectId) &&
        listChangedOnlyByProjectId(resource.data.get('guideProjectIds', []), request.resource.data.get('guideProjectIds', []), projectId) &&
        listChangedOnlyByProjectId(resource.data.get('templateProjectIds', []), request.resource.data.get('templateProjectIds', []), projectId) &&
        listChangedOnlyByProjectId(resource.data.get('archivedProjectIds', []), request.resource.data.get('archivedProjectIds', []), projectId) &&
        listChangedOnlyByProjectId(resource.data.get('copyProjectIds', []), request.resource.data.get('copyProjectIds', []), projectId) &&
        listChangedOnlyByProjectId(resource.data.get('invitedProjectIds', []), request.resource.data.get('invitedProjectIds', []), projectId);
      let projectMapsValid =
        projectMapChangedOnlyAt('lastVisitBoard', projectId) &&
        projectMapChangedOnlyAt('lastVisitBoardInGoals', projectId) &&
        projectMapChangedOnlyAt('workstreams', projectId) &&
        projectMapChangedOnlyAt('quotaWarnings', projectId) &&
        projectMapChangedOnlyAt('apisConnected', projectId) &&
        projectMapChangedOnlyAt('statisticsSelectedUsersIds', projectId) &&
        projectMapChangedOnlyAt('workflow', projectId) &&
        projectMapChangedOnlyAt('noteIdsByProject', projectId) &&
        projectMapChangedOnlyAt('unlockedKeysByGuides', projectId) &&
        unlockedKeysNotAdded(projectId) &&
        projectMapChangedOnlyAt('commentsData', projectId) &&
        projectMapChangedOnlyAtWithGlobal('lastAssistantCommentData', projectId) &&
        validFocusChange(userId, projectId);
      return signedIn() &&
        projectId is string && projectId != '' &&
        mutation.get('actorId', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectIds', 'guideProjectIds', 'templateProjectIds', 'archivedProjectIds',
          'copyProjectIds', 'invitedProjectIds', 'lastVisitBoard', 'lastVisitBoardInGoals', 'workstreams',
          'quotaWarnings', 'apisConnected', 'statisticsSelectedUsersIds', 'workflow',
          'noteIdsByProject', 'unlockedKeysByGuides', 'commentsData', 'projectMembershipMutation',
          'lastAssistantCommentData', 'lastAssistantCommentDataByAssistant',
          'lastEditionDate', 'lastEditorId', 'assistantId',
          'inFocusTaskId', 'inFocusTaskProjectId'
        ]) &&
        membershipFieldsValid && projectMapsValid &&
        (
          (
            action == 'add' &&
            request.auth.uid in projectBefore &&
            request.auth.uid in projectAfter &&
            userId in projectAfter &&
            projectId in request.resource.data.get('projectIds', [])
          ) ||
          (
            action == 'remove' &&
            request.auth.uid in projectBefore &&
            userId in projectBefore &&
            userId != request.auth.uid &&
            request.auth.uid in projectAfter &&
            !(userId in projectAfter) &&
            !(projectId in request.resource.data.get('projectIds', []))
          ) ||
          (
            action == 'project-update' &&
            request.auth.uid in projectBefore &&
            userId in projectBefore &&
            request.auth.uid in projectAfter &&
            userId in projectAfter
          ) ||
          (
            action == 'self-sync' &&
            request.auth.uid == userId &&
            userId in projectAfter
          ) ||
          (
            action == 'delete-project' &&
            request.auth.uid in projectBefore &&
            projectAfter.size() == 0 &&
            !(projectId in request.resource.data.get('projectIds', []))
          ) ||
          (
            action == 'invitation-add' &&
            onlyInvitationFieldsChange() &&
            request.auth.uid in projectBefore &&
            request.auth.uid in projectAfter &&
            projectId in request.resource.data.get('invitedProjectIds', []) &&
            doesNotAddProjectId('projectIds', projectId) &&
            doesNotAddProjectId('guideProjectIds', projectId) &&
            doesNotAddProjectId('templateProjectIds', projectId) &&
            doesNotAddProjectId('archivedProjectIds', projectId) &&
            doesNotAddProjectId('copyProjectIds', projectId)
          ) ||
          (
            action == 'invitation-remove' &&
            onlyInvitationFieldsChange() &&
            (request.auth.uid in projectBefore || request.auth.uid == userId) &&
            !(projectId in request.resource.data.get('invitedProjectIds', [])) &&
            doesNotAddProjectId('projectIds', projectId) &&
            doesNotAddProjectId('guideProjectIds', projectId) &&
            doesNotAddProjectId('templateProjectIds', projectId) &&
            doesNotAddProjectId('archivedProjectIds', projectId) &&
            doesNotAddProjectId('copyProjectIds', projectId)
          )
        );
    }

    function isProjectMember(projectId) {
      // projects/{projectId}.userIds is the authority. The arrays on users/{uid}
      // are denormalized navigation state and are owner-writable, so using them
      // for authorization lets an account add an arbitrary project id to itself.
      return signedIn() &&
        projectDoc(projectId).data.userIds is list &&
        request.auth.uid in projectDoc(projectId).data.userIds;
    }

    function isPublicSharedProject(projectId) {
      return projectDoc(projectId).data.isShared != privateProject();
    }

    function canReadObject(projectId, data) {
      // isPublicFor uses 0 as a project-public sentinel. A query with
      // array-contains-any [0, uid] cannot prove that OR to the rules engine, so
      // the Admin SDK maintains query-shaped projection fields instead:
      //   readerIds                  every caller allowed to read the object
      //   roleIdsVisibleTo.{uid}     observer/assignee ids visible to caller
      //   followedReaderIds          followers who are also allowed to read it
      //   backlinkIdsVisibleTo       linked-object tokens visible to each caller
      // Followed queries must use followedReaderIds; usersFollowing is client-writable legacy data.
      // Clients may query these fields but may never change them.
      return isProjectMember(projectId) && (
        request.auth.uid in data.get('readerIds', []) ||
        request.auth.uid in data.get('roleIdsVisibleTo', {}) ||
        request.auth.uid in data.get('backlinkIdsVisibleTo', {}) ||
        request.auth.uid in data.get('followedReaderIds', []) ||
        data.get('followedByVisibleTo', {}).get(request.auth.uid, false) == true
      );
    }

    function canReadSharedObject(projectId, data) {
      return isPublicSharedProject(projectId) && (
        publicForAll() in data.get('readerIds', []) ||
        '0' in data.get('roleIdsVisibleTo', {}) ||
        '0' in data.get('backlinkIdsVisibleTo', {})
      );
    }

    function canReadProject(projectId) {
      return isProjectMember(projectId) || isPublicSharedProject(projectId);
    }

    function canWriteObject(projectId, data) {
      return isProjectMember(projectId) &&
        data.isPublicFor is list &&
        data.isPublicFor.hasAny([publicForAll(), request.auth.uid]);
    }

    function canCreateObjectWithProject(projectId, data) {
      // Project creation and its starter objects are intentionally one atomic batch. `get()` sees
      // only the pre-batch state, so creation must validate membership through getAfter(). Updates
      // continue to require membership in the already-committed project.
      return isProjectMemberBeforeOrAfter(projectId) &&
        data.isPublicFor is list &&
        data.isPublicFor.hasAny([publicForAll(), request.auth.uid]);
    }

    function accessProjectionAbsent(data) {
      return !('readerIds' in data) &&
        !('roleIdsVisibleTo' in data) &&
        !('followedByVisibleTo' in data) &&
        !('followedReaderIds' in data) &&
        !('backlinkIdsVisibleTo' in data);
    }

    function accessProjectionUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['readerIds', 'roleIdsVisibleTo', 'followedByVisibleTo', 'followedReaderIds', 'backlinkIdsVisibleTo']);
    }

    function canAccessObjectWhileProjectionIsPending(projectId, data) {
      // Object creates and the Admin SDK projection trigger are separate
      // commits. The creating client can legitimately enqueue an immediate
      // title/follower/content update before that trigger lands. During only
      // that all-projection-fields-absent state, fall back to the same
      // isPublicFor authorization used for create. Server-owned projection
      // fields remain immutable, and callers not already named by the source
      // object still cannot grant themselves access.
      return canReadObject(projectId, data) ||
        (accessProjectionAbsent(data) && canWriteObject(projectId, data));
    }

    // A read of a document that does not exist still evaluates the object's read rule, and every
    // object rule dereferences resource.data — which is null for a missing document — so the
    // evaluation ERRORS and the client is told `permission-denied` instead of "no such document".
    // Production logs hundreds of those evaluation errors per active hour and next to no real
    // denials (AT-2484). It matters because ids are denormalized: a task's subtaskIds/parentId, a
    // note's inner-task list, a chat's object id can all point at something that is gone, and a
    // probe that cannot tell "missing" from "forbidden" either fails the operation it precedes
    // (the task-move undo capture) or fails a whole batch (a delete carrying a stale id). A
    // project member may learn that an object does not exist; nobody else may, and an EXISTING
    // private object is still governed by the ordinary read rule below because resource is not
    // null for it. `resource == null` costs no document access, unlike the exists() probe the
    // chatObjects rule predates this helper with.
    function canProbeMissingObject(projectId) {
      return resource == null && isProjectMember(projectId);
    }

    function canReadUserScopedProjectData(projectId, userId) {
      return signedIn() && request.auth.uid == userId && isProjectMember(projectId);
    }

    function canReadStoredCommentParent(projectId, parentPath) {
      return exists(parentPath) && get(parentPath).data.get('isPublicFor', []) is list && (
        (
          isProjectMember(projectId) &&
          get(parentPath).data.get('isPublicFor', []).hasAny([publicForAll(), request.auth.uid])
        ) || (
          isPublicSharedProject(projectId) &&
          publicForAll() in get(parentPath).data.get('isPublicFor', [])
        )
      );
    }

    function canWriteStoredCommentParent(projectId, parentPath) {
      return exists(parentPath) &&
        canWriteObject(projectId, get(parentPath).data);
    }

    function isProjectUserCommentParent(projectId, objectId) {
      return projectDoc(projectId).data.get('userIds', []) is list &&
        objectId in projectDoc(projectId).data.get('userIds', []);
    }

    function isStoredCommentParentType(chatType) {
      return chatType == 'tasks' || chatType == 'notes' || chatType == 'goals' ||
        chatType == 'topics' || chatType == 'contacts' || chatType == 'users' || chatType == 'skills' ||
        chatType == 'artifacts';
    }

    function isContactCommentParentType(chatType) {
      return chatType == 'contacts' || chatType == 'users';
    }

    function commentParentPath(projectId, chatType, objectId) {
      return chatType == 'tasks'
        ? /databases/$(database)/documents/items/$(projectId)/tasks/$(objectId)
        : chatType == 'notes'
          ? /databases/$(database)/documents/noteItems/$(projectId)/notes/$(objectId)
          : chatType == 'goals'
            ? /databases/$(database)/documents/goals/$(projectId)/items/$(objectId)
            : chatType == 'topics'
              ? /databases/$(database)/documents/chatObjects/$(projectId)/chats/$(objectId)
              : isContactCommentParentType(chatType)
                ? /databases/$(database)/documents/projectsContacts/$(projectId)/contacts/$(objectId)
                : chatType == 'skills'
                  ? /databases/$(database)/documents/skills/$(projectId)/items/$(objectId)
                  : chatType == 'artifacts'
                    ? /databases/$(database)/documents/artifactItems/$(projectId)/artifacts/$(objectId)
                    : /databases/$(database)/documents/invalidCommentParents/invalid/objects/$(objectId);
    }

    function assistantCommentParentExists(projectId, objectId) {
      return exists(/databases/$(database)/documents/assistants/$(projectId)/items/$(objectId)) ||
        exists(/databases/$(database)/documents/assistants/globalProject/items/$(objectId));
    }

    function canReadCommentParent(projectId, chatType, objectId) {
      let parentPath = commentParentPath(projectId, chatType, objectId);
      return (
        isStoredCommentParentType(chatType) && canReadStoredCommentParent(projectId, parentPath)
      ) || (
        isContactCommentParentType(chatType) && !exists(parentPath) &&
        isProjectUserCommentParent(projectId, objectId) && canReadProject(projectId)
      ) || (
        chatType == 'assistants' && assistantCommentParentExists(projectId, objectId) && canReadProject(projectId)
      );
    }

    function canWriteCommentParent(projectId, chatType, objectId) {
      let parentPath = commentParentPath(projectId, chatType, objectId);
      return (
        isStoredCommentParentType(chatType) && canWriteStoredCommentParent(projectId, parentPath)
      ) || (
        isContactCommentParentType(chatType) && !exists(parentPath) &&
        isProjectUserCommentParent(projectId, objectId) && isProjectMember(projectId)
      ) || (
        chatType == 'assistants' && assistantCommentParentExists(projectId, objectId) && isProjectMember(projectId)
      );
    }

    function canNotifyObjectReader(projectId, objectData, userId) {
      return projectDoc(projectId).data.get('userIds', []) is list &&
        userId in projectDoc(projectId).data.get('userIds', []) &&
        objectData.get('isPublicFor', []) is list &&
        objectData.get('isPublicFor', []).hasAny([publicForAll(), userId]);
    }

    function canNotifyObjectReaders(projectId, objectData, recipients) {
      let projectUserIds = projectDoc(projectId).data.get('userIds', []);
      let isPublicFor = objectData.get('isPublicFor', []);
      return recipients is list && recipients.size() > 0 &&
        projectUserIds is list && recipients.hasOnly(projectUserIds) &&
        isPublicFor is list && (
          publicForAll() in isPublicFor || recipients.hasOnly(isPublicFor)
        );
    }

    function canNotifyStoredCommentParent(projectId, parentPath, userId) {
      return exists(parentPath) && canNotifyObjectReader(projectId, get(parentPath).data, userId);
    }

    function canNotifyStoredCommentParentReaders(projectId, parentPath, recipients) {
      return exists(parentPath) && canNotifyObjectReaders(projectId, get(parentPath).data, recipients);
    }

    function canNotifyCommentRecipient(projectId, chatType, objectId, userId) {
      let parentPath = commentParentPath(projectId, chatType, objectId);
      return (
        isStoredCommentParentType(chatType) && canNotifyStoredCommentParent(projectId, parentPath, userId)
      ) || (
        isContactCommentParentType(chatType) && !exists(parentPath) &&
        isProjectUserCommentParent(projectId, objectId) &&
        userId in projectDoc(projectId).data.get('userIds', [])
      ) || (
        chatType == 'assistants' && assistantCommentParentExists(projectId, objectId) &&
        userId in projectDoc(projectId).data.get('userIds', [])
      );
    }

    function canNotifyCommentReaders(projectId, chatType, objectId, recipients) {
      let parentPath = commentParentPath(projectId, chatType, objectId);
      return (
        isStoredCommentParentType(chatType) &&
        canNotifyStoredCommentParentReaders(projectId, parentPath, recipients)
      ) || (
        isContactCommentParentType(chatType) && !exists(parentPath) &&
        isProjectUserCommentParent(projectId, objectId) &&
        recipients is list && recipients.size() > 0 &&
        recipients.hasOnly(projectDoc(projectId).data.get('userIds', []))
      ) || (
        chatType == 'assistants' && assistantCommentParentExists(projectId, objectId) &&
        recipients is list && recipients.size() > 0 &&
        recipients.hasOnly(projectDoc(projectId).data.get('userIds', []))
      );
    }

    // Comment authors enqueue recipient inbox rows and the scheduled push/email side-channel
    // documents in the same atomic batch as the comment. Bind every such write to that exact
    // after-state comment so a project member cannot manufacture arbitrary notifications.
    function isValidCommentNotification(data) {
      let projectId = data.get('projectId', '');
      let chatType = data.get('chatType', '');
      let objectId = data.get('objectId', '');
      let commentId = data.get('commentId', '');
      let commentPath = /databases/$(database)/documents/chatComments/$(projectId)/$(chatType)/$(objectId)/comments/$(commentId);
      return signedIn() &&
        projectId is string && projectId != '' &&
        chatType is string && chatType != '' &&
        objectId is string && objectId != '' &&
        commentId is string && commentId != '' &&
        data.get('creatorId', '') == request.auth.uid &&
        isProjectMember(projectId) &&
        canWriteCommentParent(projectId, chatType, objectId) &&
        existsAfter(commentPath) &&
        getAfter(commentPath).data.get('creatorId', '') == request.auth.uid;
    }

    function hasValidNotificationRecipients(data) {
      let projectId = data.get('projectId', '');
      let recipients = data.get('userIds', []);
      return projectId is string && projectId != '' &&
        recipients is list && recipients.size() > 0 &&
        projectDoc(projectId).data.get('userIds', []) is list &&
        recipients.hasOnly(projectDoc(projectId).data.get('userIds', [])) &&
        canNotifyCommentReaders(
          projectId,
          data.get('chatType', ''),
          data.get('objectId', ''),
          recipients
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (
          resource.data.projectIds is list &&
          userDoc(request.auth.uid).data.projectIds is list &&
          resource.data.projectIds.hasAny(userDoc(request.auth.uid).data.projectIds)
        )
      );
      allow create: if signedIn() && request.auth.uid == userId &&
        emailMatchesAuthToken(request.resource.data) &&
        newUserHasDefaultServerFields(request.resource.data) &&
        hasValidDefaultProject(userId, request.resource.data) &&
        hasValidInitialProjectMembership(userId, request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId &&
        ownerUpdatePreservesProjectMembership() &&
        ownerUpdateKeepsEmailHonest() &&
        ownerUpdateKeepsServerFields() &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['defaultProjectId']) ||
          hasValidDefaultProject(userId, request.resource.data)
        ) || isValidProjectMembershipMutation(userId) || isAdministrator();
      allow delete: if signedIn() && (request.auth.uid == userId || isAdministrator());
    }

    // OAuth credential documents are written ONLY by Cloud Functions, right after the
    // provider itself confirmed which mailbox or calendar the tokens belong to. They stay
    // owner-readable (the app renders connection state from them), but a client write is
    // refused: fabricating `private/googleAuth_…` is otherwise all it takes for an account
    // to present somebody else's address as a connected mailbox, which the Anna email
    // channel used to accept as proof of ownership (AT-2483). Everything else under
    // private/ keeps owner read+write — clockSync, gmailLabeling_*, calendarProjectRouting_*
    // and taskPriorityLearning are all written from the app.
    match /users/{userId}/private/{privateDocId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId &&
        !privateDocId.matches('(googleAuth|microsoftAuth)_.*');
    }

    // One named segment before the recursive wildcard, so this cannot also match the
    // private document itself and hand back the write the rule above just withheld
    // (`{nested=**}` matches zero segments). Covers e.g. gmailLabelingState_*/messages/*.
    match /users/{userId}/private/{privateDocId}/{nestedCollection}/{nested=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Include one named segment before the recursive wildcard. In rules v2 a
    // `{document=**}` wildcard can match zero segments, so the old shape also
    // matched users/{userId} itself and silently bypassed every field-level
    // restriction in the rule above.
    match /users/{userId}/{userSubcollection}/{document=**} {
      allow read: if signedIn() && request.auth.uid == userId &&
        userSubcollection != 'private';
      allow write: if signedIn() && request.auth.uid == userId &&
        userSubcollection != 'private' &&
        !isServerOwnedUserCollection(userSubcollection);
    }

    // Raw personal provider API keys are server-only. Unlike the legacy
    // users/{uid}/private subtree, this path cannot be read back by any client,
    // including its owner; Cloud Functions access it through the Admin SDK.
    match /userSecrets/{userId}/{document=**} {
      allow read, write: if false;
    }

    // security audit 2026-11 (NV-12): a project document names who belongs to it (userIds) and who
    // created it (creatorId), and the server trusts both: the project wiki is billed to an active
    // creatorId listed in userIds (functions/KnowledgeBase/knowledgeBaseDefaults.js), and every
    // `isProjectMember` check reads userIds. So a client may only create a project that holds just
    // itself and names itself creator, and may never rewrite the creator afterwards. The one
    // exception on both sides is a guide (`parentTemplateId`): the user starting it creates it in the
    // name of the template's creator, and adds that creator and the administrator as members
    // (utils/backends/Projects/guidesFirestore.js). Guides never get a default wiki.
    function administratorUserId() {
      let rolePath = /databases/$(database)/documents/roles/administrator;
      return exists(rolePath) ? get(rolePath).data.get('userId', '') : '';
    }

    // The templateCreatorId of the template a guide was started from, or '' when the project is not
    // a guide of a real template.
    function guideTemplateCreatorId(data) {
      let templateId = data.get('parentTemplateId', '');
      return templateId is string && templateId != '' &&
          exists(/databases/$(database)/documents/projects/$(templateId)) &&
          get(/databases/$(database)/documents/projects/$(templateId)).data.get('isTemplate', false) == true
        ? get(/databases/$(database)/documents/projects/$(templateId)).data.get('templateCreatorId', '')
        : '';
    }

    function newProjectBoundToCreator(data) {
      let creatorId = data.get('creatorId', null);
      let templateCreatorId = data.get('templateCreatorId', '');
      return data.get('userIds', null) == [request.auth.uid] &&
        (
          creatorId == request.auth.uid ||
          (creatorId is string && creatorId != '' && creatorId == guideTemplateCreatorId(data))
        ) &&
        (templateCreatorId == '' || templateCreatorId == null || templateCreatorId == request.auth.uid);
    }

    // Members only ever leave through a project update; joining is the guide flow above. (A plain
    // project's members are added by the invitee's own acceptance, which this rule does not open.)
    function projectMembersAddedOnlyToGuide() {
      let added = request.resource.data.get('userIds', []).toSet()
        .difference(resource.data.get('userIds', []).toSet());
      return added.size() == 0 ||
        (
          resource.data.get('parentTemplateId', '') is string &&
          resource.data.get('parentTemplateId', '') != '' &&
          added.hasOnly([administratorUserId(), guideTemplateCreatorId(resource.data)])
        );
    }

    // Kicking a template's creator hands the template to the administrator
    // (updateProjectDataWhenKickUserFromProject); nothing else may change it.
    function templateCreatorUnchangedOrAdministrator() {
      return request.resource.data.get('templateCreatorId', '') == resource.data.get('templateCreatorId', '') ||
        request.resource.data.get('templateCreatorId', '') == administratorUserId();
    }

    match /projects/{projectId} {
      // Project-list queries filter `userIds` with array-contains. Express membership against the
      // candidate resource so the rules engine can prove that query; routing through
      // `projectDoc(projectId)` is equivalent for a single read but opaque to collection queries.
      allow read: if signedIn() && request.auth.uid in resource.data.get('userIds', []);
      // Incident 2026-11-08: a project shared "With link" may be opened by anyone who has its id,
      // but never listed. `read` (get + list) let anyone, even signed out, query every such
      // project and harvest the ids of their projects and notes. No client query lists projects
      // without a userIds filter, so only the single-document read stays open.
      allow get: if resource.data.get('isShared', privateProject()) != privateProject();
      allow create: if signedIn() && newProjectBoundToCreator(request.resource.data);
      // security audit 2026-11: the repository connection and the golden VM environment feed
      // other members' credentialed VM coding jobs, so only Cloud Functions write them
      // (connect/disconnect{Github,Gitlab}Repo, the golden build). `vmGolden` here is a display
      // mirror; the authoritative state is the server-only vmGoldens/{projectId}.
      allow update: if isProjectMember(projectId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'vmGolden',
          'githubRepoUrl', 'githubBaseBranch', 'githubHost', 'githubApiBase', 'githubConnectedAt',
          'gitlabRepoUrl', 'gitlabBaseBranch', 'gitlabHost', 'gitlabConnectedAt',
          'creatorId', 'isTemplate', 'parentTemplateId'
        ]) &&
        projectMembersAddedOnlyToGuide() &&
        templateCreatorUnchangedOrAdministrator();
      allow delete: if signedIn() &&
        request.auth.uid in resource.data.get('userIds', []);
    }

    // Security audit 2026-11: Firestore triggers have no request.auth. Every task field that a
    // trigger treats as "the user who asked for this" (and then spends that user's Gold, reads
    // that user's private goals or rules, or runs an assistant with that user's tools) has to be
    // bound to the writer HERE, at the moment it is written. Each rule below fires only when the
    // field is written (present on create, changed on update), so writes that leave it alone, and
    // Admin SDK writes, are unaffected. Pinned by the `task identity fields` block of
    // __tests__/Firestore/firestoreRules.emulator.test.js.

    // Automatic project routing (functions/Tasks/taskProjectRouting.js) acts as creatorId.
    function projectRoutingRequestBoundToWriter(data) {
      return !(data.get('projectRouting', null) is map &&
          data.projectRouting.get('status', null) == 'pending') ||
        data.get('creatorId', null) == request.auth.uid;
    }

    function goalRoutingEligible(data) {
      return data.get('parentId', null) == null &&
        data.get('isSubtask', false) != true &&
        data.get('parentGoalId', null) == null &&
        data.get('done', false) != true &&
        data.get('inDone', false) != true &&
        data.get('goalSuggestion', null) == null;
    }

    // Automatic goal routing (functions/Tasks/taskGoalRouting.js) acts only for a created task
    // whose creatorId equals its lastEditorId; a client may only create such a task as itself.
    function goalRoutingIdentityBoundToWriter(data) {
      let creatorId = data.get('creatorId', null);
      return creatorId == null || creatorId == '' || creatorId == request.auth.uid ||
        creatorId != data.get('lastEditorId', null) ||
        !goalRoutingEligible(data);
    }

    function calendarRoutingMarker(data, markerName) {
      return data.get('calendarData', null) is map ? data.calendarData.get(markerName, null) : null;
    }

    // Calendar routing feedback rewrites the requester's private routing rules.
    function calendarRoutingMarkerBoundToWriter(before, after, markerName) {
      let marker = calendarRoutingMarker(after, markerName);
      return marker == null || marker == calendarRoutingMarker(before, markerName) ||
        (marker is map && marker.get('requestedByUserId', '') == request.auth.uid);
    }

    // An AI workflow run is paid for by, and acts as, workflowPayerUserId.
    function workflowPayerBoundToWriter(before, after) {
      let payer = after.get('workflowPayerUserId', null);
      return payer == null || payer == before.get('workflowPayerUserId', null) ||
        payer == request.auth.uid;
    }

    // Moving an assistant workflow task (workflowTask) into a step makes the mover the payer:
    // otherwise a co-member could re-enter an AI step and spend a payer stamped earlier.
    // Moves to Open (-1) and Done (-2) start no run.
    function workflowTransitionPaidByWriter(before, after) {
      let steps = after.get('stepHistory', []);
      return !(after.get('workflowTask', false) == true &&
          after.get('parentId', null) == null &&
          steps is list && steps.size() > 0 &&
          steps != before.get('stepHistory', []) &&
          !(steps[steps.size() - 1] in [-1, -2])) ||
        after.get('workflowPayerUserId', null) == request.auth.uid;
    }

    // A prompt override names its author; the server runs it only as that author.
    function workflowPromptOverrideBoundToWriter(before, after) {
      let override = after.get('workflowAiPromptOverride', null);
      return override == null || override == before.get('workflowAiPromptOverride', null) ||
        (override is map && override.get('requestedByUserId', request.auth.uid) == request.auth.uid);
    }

    // Links that the app hands to window.open / <a href> / <iframe src> must be web links: a
    // javascript: URL in any of them runs script in a colleague's session when clicked (security
    // audit 2026-11, NV-03/NV-36; the client also refuses them in utils/safeUrl.js). An existing
    // value may stay as it is, so documents written before this rule are not locked.
    function isWebLinkOrEmpty(value) {
      return value == null || value == '' || (value is string && value.matches('https?://.+'));
    }

    function calendarLink(data) {
      return data.get('calendarData', null) is map ? data.calendarData.get('link', null) : null;
    }

    function calendarLinkSafe(before, after) {
      return calendarLink(after) == calendarLink(before) || isWebLinkOrEmpty(calendarLink(after));
    }

    function linkFieldSafe(before, after, field) {
      return after.get(field, null) == before.get(field, null) || isWebLinkOrEmpty(after.get(field, null));
    }

    function taskIdentityFieldsBoundToWriter(before, after) {
      return calendarLinkSafe(before, after) &&
        calendarRoutingMarkerBoundToWriter(before, after, 'projectRoutingFeedback') &&
        calendarRoutingMarkerBoundToWriter(before, after, 'goalRoutingFeedback') &&
        workflowPayerBoundToWriter(before, after) &&
        workflowTransitionPaidByWriter(before, after) &&
        workflowPromptOverrideBoundToWriter(before, after);
    }

    match /items/{projectId}/tasks/{taskId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if
        request.resource.data.get('projectId', '') == projectId &&
        canCreateObjectWithProject(projectId, request.resource.data) &&
        accessProjectionAbsent(request.resource.data) &&
        projectRoutingRequestBoundToWriter(request.resource.data) &&
        goalRoutingIdentityBoundToWriter(request.resource.data) &&
        taskIdentityFieldsBoundToWriter({}, request.resource.data);
      allow update: if
        resource.data.get('projectId', '') == projectId &&
        request.resource.data.get('projectId', '') == projectId &&
        canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) &&
        accessProjectionUnchanged() &&
        taskIdentityFieldsBoundToWriter(resource.data, request.resource.data);
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    match /noteItems/{projectId}/notes/{noteId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    // Project artifacts (functions/Artifacts/artifactModel.js). Read exactly like notes. Only Cloud
    // Functions create artifacts and write their versions; a member may edit the metadata (title,
    // description, privacy, star, followers) but never the server-owned fields: the serve secret
    // that makes up the artifact's address, and the pointer to and description of its current
    // version, which decide what serveArtifact serves and whether it is sandboxed.
    function artifactServerFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'serveSecret', 'serveSecretRotatedAt', 'currentVersionId', 'versionCount', 'kind', 'mimeType',
        'entryPath', 'sizeBytes', 'fileCount', 'source', 'creatorId', 'created', 'creatorAssistantId',
        'vmOutputKey', 'parentObject', 'dataAccess', 'publicLink'
      ]);
    }

    match /artifactItems/{projectId}/artifacts/{artifactId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if false;
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged() &&
        artifactServerFieldsUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);

      match /versions/{versionId} {
        allow read: if canAccessObjectWhileProjectionIsPending(
            projectId,
            get(/databases/$(database)/documents/artifactItems/$(projectId)/artifacts/$(artifactId)).data
          ) || canReadSharedObject(
            projectId,
            get(/databases/$(database)/documents/artifactItems/$(projectId)/artifacts/$(artifactId)).data
          );
        allow write: if false;
      }

      // What happened to the artifact, written only by Cloud Functions (functions/Artifacts/
      // artifactHistory.js) and readable exactly like its versions.
      match /history/{eventId} {
        allow read: if canAccessObjectWhileProjectionIsPending(
            projectId,
            get(/databases/$(database)/documents/artifactItems/$(projectId)/artifacts/$(artifactId)).data
          ) || canReadSharedObject(
            projectId,
            get(/databases/$(database)/documents/artifactItems/$(projectId)/artifacts/$(artifactId)).data
          );
        allow write: if false;
      }
    }

    match /noteItemsVersions/{projectId}/{noteId}/{versionId} {
      allow read, write: if canAccessObjectWhileProjectionIsPending(
        projectId,
        get(/databases/$(database)/documents/noteItems/$(projectId)/notes/$(noteId)).data
      );
    }

    match /noteItemsDailyVersions/{projectId}/notes/{noteId} {
      allow read, write: if canAccessObjectWhileProjectionIsPending(
        projectId,
        get(/databases/$(database)/documents/noteItems/$(projectId)/notes/$(noteId)).data
      );
    }

    match /goals/{projectId}/items/{goalId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    match /chatObjects/{projectId}/chats/{chatId} {
      // Tasks, notes and goals share the follower helper with chats. Most objects never
      // create a chat document, so the helper must be able to distinguish "not created"
      // from "exists but is private" without opening any existing conversation.
      allow get: if isProjectMember(projectId) &&
        !exists(/databases/$(database)/documents/chatObjects/$(projectId)/chats/$(chatId));
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    match /projectsContacts/{projectId}/contacts/{contactId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    match /skills/{projectId}/items/{skillId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) ||
        canReadSharedObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    match /okrs/{projectId}/projectOkrs/{okrId} {
      allow get: if canProbeMissingObject(projectId);
      allow read: if canAccessObjectWhileProjectionIsPending(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canAccessObjectWhileProjectionIsPending(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canProbeMissingObject(projectId) ||
        canAccessObjectWhileProjectionIsPending(projectId, resource.data);
    }

    // The global assistant catalog lives under the pseudo project 'globalProject', whose
    // project document has no members, so a membership check alone rejects everyone —
    // including the administrator who curates it. Every pre-configured task edit on a
    // global assistant also bumps the assistant document in the same batch, so the whole
    // batch was denied. Same shape as the global skill catalog: admin-only writes.
    function isGlobalAssistantCatalog(projectId) {
      return projectId == 'globalProject';
    }

    match /assistants/{projectId}/items/{assistantId} {
      allow read: if isGlobalAssistantCatalog(projectId) || canReadProject(projectId);
      allow create: if (isGlobalAssistantCatalog(projectId) && isAdministrator()) ||
        isProjectMemberBeforeOrAfter(projectId);
      allow update, delete: if (isGlobalAssistantCatalog(projectId) && isAdministrator()) ||
        isProjectMember(projectId);
    }

    // Per-assistant MCP server secrets (bearer tokens / OAuth tokens). Server-only:
    // written + read exclusively by Cloud Functions via the Admin SDK (which bypasses
    // rules). Never exposed to clients — the non-secret config (label, url, tokenLast4)
    // lives on the assistant doc above.
    match /assistants/{projectId}/mcpSecrets/{secretId} {
      allow read, write: if false;
    }

    // Server-managed heartbeat dispatch registry. It contains internal timing
    // and execution state and must never be client-readable or client-writable.
    match /assistantHeartbeatSchedules/{scheduleId} {
      allow read, write: if false;
    }

    // Server-managed queue of AI workflow step runs. Its ids are the idempotency key that stops a
    // redelivered task update from paying for the same assistant run twice, so clients must never
    // be able to read or forge one.
    match /workflowAiRuns/{runId} {
      allow read, write: if false;
    }

    // Resumable server-owned jobs used to reconcile query projections after a
    // project's membership changes. They contain the authoritative member list
    // and processing cursors, so no client may observe or alter them.
    match /firestoreAccessProjectionJobs/{projectId} {
      allow read, write: if false;
    }

    // Durable cursor for server-owned projection schema migrations. Like the per-project jobs,
    // this is backend coordination state and never client data.
    match /firestoreAccessProjectionMigrations/{migrationId} {
      allow read, write: if false;
    }

    function isAdministrator() {
      return signedIn() && get(/databases/$(database)/documents/roles/administrator).data.userId == request.auth.uid;
    }

    // A skill catalog is keyed by the project that owns it (AT-2450). Two kinds live
    // in the same shape and they are NOT interchangeable:
    //
    //   assistantSkills/globalProject/items/*  — the curated catalog every user reads
    //                                            and only the administrator may write.
    //   assistantSkills/{realProjectId}/items/* — a project's own skills, readable and
    //                                            writable by that project's members.
    //
    // Keying on the PATH rather than on a field is what keeps the collection queries
    // legal: a query is rejected outright when any document it could return might be
    // denied, so a field-scoped `creatorId`/`projectId` rule would break the
    // unfiltered `.orderBy('lastEditionDate')` listing that both catalogs are read
    // with. The path segment is known before the query runs, so each listing is
    // provably safe on its own.
    function isGlobalSkillCatalog(projectId) {
      return projectId == 'globalProject';
    }

    match /assistantSkills/{projectId}/items/{skillId} {
      allow read: if (isGlobalSkillCatalog(projectId) && signedIn()) ||
        (!isGlobalSkillCatalog(projectId) && isProjectMember(projectId));
      // `creatorId` is pinned to the caller on create and frozen on update: it is the
      // only attribution a project skill carries, and the write rule is the sole thing
      // enforcing it now that clients other than the administrator can write here.
      allow create: if (isGlobalSkillCatalog(projectId) && isAdministrator()) ||
        (!isGlobalSkillCatalog(projectId) && isProjectMember(projectId) &&
          request.resource.data.creatorId == request.auth.uid);
      allow update: if (isGlobalSkillCatalog(projectId) && isAdministrator()) ||
        (!isGlobalSkillCatalog(projectId) && isProjectMember(projectId) &&
          request.resource.data.creatorId == resource.data.creatorId &&
          request.resource.data.lastEditorId == request.auth.uid);
      allow delete: if (isGlobalSkillCatalog(projectId) && isAdministrator()) ||
        (!isGlobalSkillCatalog(projectId) && isProjectMember(projectId));
    }

    // Staged GitHub imports awaiting review. The flat collection is the administrator's
    // global-catalog staging area and is deliberately left exactly as it was — it holds
    // live documents in production, so moving it would strand them.
    match /assistantSkillImports/{importId} {
      allow read, write: if isAdministrator();
    }

    // Project imports stage under their own project instead, for the same
    // query-safety reason as the catalog above.
    match /assistantSkillImports/{projectId}/items/{importId} {
      allow read, write: if isProjectMember(projectId);
    }

    match /assistantSkillImportJobs/{jobId} {
      // Progress of one import run, watched by id (never queried), so the requester
      // can be identified from the document itself.
      allow read: if isAdministrator() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }

    // Security audit 2026-11: the recurring-task scheduler (functions/Assistant/
    // assistantRecurringTasks.js) runs a task's prompt AS every user its activation fields name,
    // in the project they name for that user. Those fields are therefore bound to their writer:
    // a client may add or change only its own activation entry (removing someone else's only
    // stops a run), may point its own entry only at a project it belongs to, and may name only
    // itself as activator, creator or userId. A legacy task without explicit activation state
    // runs for activatorUserId/creatorUserId/userId, so materializing exactly those ids into
    // activatedUserIds is no escalation and stays allowed.
    function listOrEmpty(value) {
      return value is list ? value : [];
    }

    function mapOrEmpty(value) {
      return value is map ? value : {};
    }

    function addedOnlyOwnMapKeys(before, after, field) {
      let beforeMap = mapOrEmpty(before.get(field, {}));
      let afterMap = mapOrEmpty(after.get(field, {}));
      let changes = afterMap.diff(beforeMap);
      return changes.addedKeys().union(changes.changedKeys()).hasOnly([request.auth.uid]);
    }

    function legacyActivationIds(before) {
      return before.get('activatedUserIds', null) == null && before.get('recurrenceByUser', null) == null
        ? [request.auth.uid, before.get('activatorUserId', null), before.get('creatorUserId', null),
            before.get('userId', null)]
        : [request.auth.uid];
    }

    function unchangedOrWriter(before, after, field) {
      return after.get(field, null) == before.get(field, null) || after.get(field, null) == request.auth.uid;
    }

    // The shared activatedInProjectId is where every legacy activation without a per-user entry
    // runs, so only a writer who also names itself activator may move it.
    function ownActivationProjectOnly(before, after, isCreate) {
      let afterProjects = mapOrEmpty(after.get('activatedInProjectIdByUser', {}));
      let ownProject = afterProjects.get(request.auth.uid, null);
      let sharedProject = after.get('activatedInProjectId', null);
      return addedOnlyOwnMapKeys(before, after, 'activatedInProjectIdByUser') &&
        (ownProject == null ||
          ownProject == mapOrEmpty(before.get('activatedInProjectIdByUser', {})).get(request.auth.uid, null) ||
          (ownProject is string && isProjectMember(ownProject))) &&
        (sharedProject == null || sharedProject == before.get('activatedInProjectId', null) ||
          (sharedProject is string && isProjectMember(sharedProject) &&
            (isCreate || after.get('activatorUserId', null) == request.auth.uid)));
    }

    function assistantTaskActivationBoundToWriter(before, after, isCreate) {
      return listOrEmpty(after.get('activatedUserIds', [])).toSet()
          .difference(listOrEmpty(before.get('activatedUserIds', [])).toSet())
          .hasOnly(legacyActivationIds(before)) &&
        addedOnlyOwnMapKeys(before, after, 'recurrenceByUser') &&
        addedOnlyOwnMapKeys(before, after, 'lastExecutedByUser') &&
        ownActivationProjectOnly(before, after, isCreate) &&
        unchangedOrWriter(before, after, 'activatorUserId') &&
        unchangedOrWriter(before, after, 'creatorUserId') &&
        unchangedOrWriter(before, after, 'userId');
    }

    // The global catalog is curated: only the administrator creates, deletes or changes what a
    // global task runs. Every other field of a catalog task (name, prompt, aiSystemMessage, model,
    // recurrence, start time, ...) is copied into the derived tasks of every tenant by
    // onUpdateAssistantTaskSecondGen, so a non-administrator may touch ONLY the per-user activation
    // keys below, and within each of them only its own entry (security audit 2026-11, NV-22). The
    // shared activatedInProjectId is deliberately not on the list; a global activation records its
    // project per user.
    function onlyOwnMapEntryAffected(before, after, field) {
      return mapOrEmpty(after.get(field, {})).diff(mapOrEmpty(before.get(field, {}))).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    function onlyOwnListEntryAffected(before, after, field) {
      let beforeIds = listOrEmpty(before.get(field, [])).toSet();
      let afterIds = listOrEmpty(after.get(field, [])).toSet();
      return afterIds.difference(beforeIds).hasOnly([request.auth.uid]) &&
        beforeIds.difference(afterIds).hasOnly([request.auth.uid]);
    }

    function globalAssistantTaskActivationOnly() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly([
          'activatedUserIds', 'recurrenceByUser', 'activatedInProjectIdByUser', 'lastExecutedByUser',
          'completedOneOffUserIds', 'activatorUserId', 'creatorUserId'
        ]) &&
        listOrEmpty(after.get('activatedUserIds', [])).toSet()
          .difference(listOrEmpty(before.get('activatedUserIds', [])).toSet())
          .hasOnly(legacyActivationIds(before)) &&
        listOrEmpty(before.get('activatedUserIds', [])).toSet()
          .difference(listOrEmpty(after.get('activatedUserIds', [])).toSet())
          .hasOnly([request.auth.uid]) &&
        onlyOwnMapEntryAffected(before, after, 'recurrenceByUser') &&
        onlyOwnMapEntryAffected(before, after, 'lastExecutedByUser') &&
        onlyOwnMapEntryAffected(before, after, 'activatedInProjectIdByUser') &&
        onlyOwnListEntryAffected(before, after, 'completedOneOffUserIds') &&
        ownActivationProjectOnly(before, after, false) &&
        unchangedOrWriter(before, after, 'activatorUserId') &&
        (after.get('creatorUserId', null) == before.get('creatorUserId', null) ||
          (before.get('creatorUserId', null) == null && after.get('creatorUserId', null) == request.auth.uid));
    }

    function globalAssistantTaskUpdateAllowed() {
      return isAdministrator() || (signedIn() && globalAssistantTaskActivationOnly());
    }

    function assistantTaskReadAllowed(projectId) {
      return projectId == 'globalProject' ? signedIn() : isProjectMember(projectId);
    }

    function assistantTaskCreateAllowed(projectId) {
      return projectId == 'globalProject'
        ? isAdministrator()
        : isProjectMember(projectId) && assistantTaskActivationBoundToWriter({}, request.resource.data, true) &&
          linkFieldSafe({}, request.resource.data, 'link');
    }

    function assistantTaskUpdateAllowed(projectId) {
      return projectId == 'globalProject'
        ? globalAssistantTaskUpdateAllowed()
        : isProjectMember(projectId) && assistantTaskActivationBoundToWriter(resource.data, request.resource.data, false) &&
          linkFieldSafe(resource.data, request.resource.data, 'link');
    }

    function assistantTaskDeleteAllowed(projectId) {
      return projectId == 'globalProject' ? isAdministrator() : isProjectMember(projectId);
    }

    match /assistantTasks/{projectId}/{assistantId}/{taskId} {
      allow read: if assistantTaskReadAllowed(projectId);
      allow create: if assistantTaskCreateAllowed(projectId);
      allow update: if assistantTaskUpdateAllowed(projectId);
      allow delete: if assistantTaskDeleteAllowed(projectId);
    }

    match /assistantTasks/{projectId}/preConfigTasks/{taskId} {
      allow read: if assistantTaskReadAllowed(projectId);
      allow create: if assistantTaskCreateAllowed(projectId);
      allow update: if assistantTaskUpdateAllowed(projectId);
      allow delete: if assistantTaskDeleteAllowed(projectId);
    }

    match /projectHappiness/{projectId}/users/{userId}/days/{dayId} {
      allow read, write: if canReadUserScopedProjectData(projectId, userId);
    }

    // Project wiki: pages, their revisions, corrections and run logs under one project. It is
    // compiled server-side only from objects every member may read, so the whole tree has a
    // single audience, the project's members. Only Cloud Functions write it; settings go through
    // the setKnowledgeBaseSettings callable.
    match /knowledgeBases/{projectId}/{document=**} {
      allow read: if isProjectMember(projectId);
      allow write: if false;
    }

    match /statistics/{projectId}/{userId}/{dayId} {
      allow read: if isProjectMember(projectId);
      allow write: if canReadUserScopedProjectData(projectId, userId);
    }

    // Aggregated gold earn/spend rollups (daily/monthly). Computed server-side by
    // the aggregateGoldTransactionStats trigger; only administrators may read them.
    match /goldStats/{document=**} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    match /chatComments/{projectId}/{chatType}/{objectId}/comments/{commentId} {
      allow read: if canReadCommentParent(projectId, chatType, objectId);
      // A member may only create a comment authored as themselves: if creatorId is set it must
      // equal the caller's uid. This blocks forging a comment as another user (impersonation /
      // confused-deputy). Assistant/system comments are written server-side (admin SDK) and bypass
      // rules, so they are unaffected.
      allow create: if canWriteCommentParent(projectId, chatType, objectId)
        && (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid);
      allow update: if canWriteCommentParent(projectId, chatType, objectId) &&
        resource.data.get('creatorId', '') == request.auth.uid &&
        request.resource.data.get('creatorId', '') == resource.data.get('creatorId', '');
      allow delete: if canWriteCommentParent(projectId, chatType, objectId) &&
        resource.data.get('creatorId', '') == request.auth.uid;
    }

    // VM runtime documents are server-managed. A client may only observe a session when it can
    // already read the associated task; sandbox ids and status must never be client-writable.
    match /vmSessions/{sessionId} {
      allow read: if resource.data.projectId is string
        && resource.data.objectId is string
        && exists(/databases/$(database)/documents/items/$(resource.data.projectId)/tasks/$(resource.data.objectId))
        && (
          canReadObject(
            resource.data.projectId,
            get(/databases/$(database)/documents/items/$(resource.data.projectId)/tasks/$(resource.data.objectId)).data
          ) ||
          canReadSharedObject(
            resource.data.projectId,
            get(/databases/$(database)/documents/items/$(resource.data.projectId)/tasks/$(resource.data.objectId)).data
          )
        );
      // Most tasks never had a VM run, so the VM badges and filters routinely watch a session that
      // does not exist. The rule above dereferences resource.data, which is an evaluation error for
      // a missing document, so every one of those listeners was rejected as permission-denied — and
      // a rejected listener that is unsubscribed at the wrong moment makes Firestore close the whole
      // Listen stream ("Target id not found"). The id is `${projectId}__${objectId}`, so a project
      // member may learn that no session exists; an existing session still needs the task read.
      allow get: if canProbeMissingObject(sessionId.split('__')[0]);
      allow write: if false;
    }

    // A pending browser-tool approval, so the card can appear in the thread the moment the assistant
    // stops and asks. READ ONLY, and only for the person the request was raised for: the answer is
    // minted exclusively by `respondToBrowserApprovalSecondGen`, which is also where the "may this
    // category be approved for the whole run" rule is enforced. A client that could write here could
    // approve its own payment.
    //
    // The browsing RUN and its steps (`browserRuns`) stay unreadable by design — they hold the audit
    // trail and the redacted page evidence, which only the server has any business reading.
    match /browserApprovals/{approvalId} {
      allow read: if signedIn() && resource.data.get('requestUserId', '') == request.auth.uid;
      allow write: if false;
    }

    // MCP Apps views under an assistant answer (functions/MCP/mcpAppViews.js). Only the person the
    // run acted for may read one; the server writes them.
    match /mcpAppViews/{viewId} {
      allow read: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow write: if false;
    }

    match /projectsFeeds/{projectId}/{dateId}/{feedId} {
      allow read: if canReadObject(projectId, resource.data) || canReadSharedObject(projectId, resource.data);
      // A missing feed object must read as "missing", not as a rules error: the Updates list
      // treats a failed read as a pending access projection and retries it forever, while a
      // clean miss lets getFeedObject rebuild the object. Same probe as the object collections.
      allow get: if canProbeMissingObject(projectId);
      allow create: if isProjectMember(projectId) && accessProjectionAbsent(request.resource.data);
      allow update: if isProjectMember(projectId) && accessProjectionUnchanged();
      allow delete: if isProjectMember(projectId);
    }

    match /projectsInnerFeeds/{projectId}/{objectType}/{objectId}/feeds/{feedId} {
      allow read: if canReadObject(projectId, resource.data) || canReadSharedObject(projectId, resource.data);
      allow get: if canProbeMissingObject(projectId);
      allow create: if isProjectMember(projectId) && accessProjectionAbsent(request.resource.data);
      allow update: if isProjectMember(projectId) && accessProjectionUnchanged();
      allow delete: if isProjectMember(projectId);
    }

    match /feedsStore/{projectId}/all/{feedId} {
      allow read: if canReadObject(projectId, resource.data) || canReadSharedObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canReadObject(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canReadObject(projectId, resource.data) || canProbeMissingObject(projectId);
    }

    match /feedsStore/{projectId}/{userId}/feeds/followed/{feedId} {
      allow read: if signedIn() && request.auth.uid == userId && canReadObject(projectId, resource.data);
      allow create: if canWriteObject(projectId, request.resource.data) && accessProjectionAbsent(request.resource.data);
      allow update: if canReadObject(projectId, resource.data) &&
        canWriteObject(projectId, request.resource.data) && accessProjectionUnchanged();
      allow delete: if canReadObject(projectId, resource.data) ||
        (signedIn() && request.auth.uid == userId && canProbeMissingObject(projectId));
    }

    match /feedsCount/{projectId}/{userId}/{document=**} {
      // The feed event creator fans out an unread counter to the other project
      // members in the same batch as the event. Counters contain no private
      // source data and remain readable/deletable only by their owner; writes
      // are limited to real members and real member targets.
      allow read, delete: if signedIn() && request.auth.uid == userId && isProjectMember(projectId);
      allow create, update: if isProjectMember(projectId) &&
        projectDoc(projectId).data.userIds is list &&
        userId in projectDoc(projectId).data.userIds;
    }

    match /chatNotifications/{projectId}/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId && isProjectMember(projectId);
    }

    match /chatNotifications/{projectId}/{userId}/{notificationId} {
      allow create: if projectDoc(projectId).data.get('userIds', []) is list &&
        userId in projectDoc(projectId).data.get('userIds', []) &&
        request.resource.data.get('projectId', '') == projectId &&
        request.resource.data.get('commentId', '') == notificationId &&
        canNotifyCommentRecipient(
          projectId,
          request.resource.data.get('chatType', ''),
          request.resource.data.get('objectId', ''),
          userId
        ) &&
        isValidCommentNotification(request.resource.data);
    }

    match /notifications/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /karmaPoints/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /payments/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // The Mollie subscription callables act on subscriptions/{auth.uid} and trust its billing
    // fields (customerId, subscriptionIdInMollie, status, seat lists), so only Cloud Functions
    // create it or change them. The app edits the company data and its seat selection, clears the
    // payment banner, and may delete its own document (security audit 2026-11).
    match /subscriptions/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['companyData', 'selectedUserIds', 'showSuccessfullyPayment']);
    }

    match /subscriptionsPaidByOtherUser/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /invoiceNumbers/customInvoiceNumber/users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /invoiceData/{projectId}/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId && isProjectMember(projectId);
    }

    function isUserProjectMemberBeforeOrAfter(projectId, userId) {
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      let beforeIds = exists(projectPath) ? get(projectPath).data.get('userIds', []) : [];
      let afterIds = existsAfter(projectPath) ? getAfter(projectPath).data.get('userIds', []) : [];
      return userId in beforeIds || userId in afterIds;
    }

    // security audit 2026-11 (NV-14): a teammate may reload somebody's sessions only through a
    // project BOTH of them belong to (before or after the write: deleting a project and kicking a
    // member reload people who are on their way out). Naming a project only the writer is in used
    // to be enough, which let anybody put any account into a reload loop.
    match /userForceReloads/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && (
        request.auth.uid == userId ||
        isAdministrator() ||
        (
          request.resource.data.keys().hasOnly(['reload', 'projectId']) &&
          request.resource.data.projectId is string &&
          request.resource.data.projectId != '' &&
          isProjectMemberBeforeOrAfter(request.resource.data.projectId) &&
          isUserProjectMemberBeforeOrAfter(request.resource.data.projectId, userId)
        )
      );
    }

    match /emailNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.userIds is list && request.auth.uid in resource.data.userIds;
      allow create: if isValidCommentNotification(request.resource.data) &&
        hasValidNotificationRecipients(request.resource.data);
      allow update: if request.resource.data.get('commentId', '') != '' &&
        isValidCommentNotification(request.resource.data) &&
        hasValidNotificationRecipients(request.resource.data);
    }

    match /pushNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.userIds is list && request.auth.uid in resource.data.userIds;
      allow create: if request.resource.data.get('commentId', '') == notificationId &&
        isValidCommentNotification(request.resource.data) &&
        hasValidNotificationRecipients(request.resource.data);
    }

    match /followers/{projectId}/{objectType}/{objectId} {
      allow read, write: if isProjectMember(projectId);
    }

    match /usersFollowing/{projectId}/entries/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && isProjectMember(projectId);
    }

    match /workstreams/{projectId}/items/{workstreamId} {
      allow read: if isProjectMember(projectId);
      allow write: if isProjectMember(projectId);
    }

    // The active web client uses these legacy collection names/shapes. Keep
    // them explicit so a renamed backend path cannot silently fall through to
    // the final deny rule.
    match /projectsWorkstreams/{projectId}/workstreams/{workstreamId} {
      allow read, update, delete: if isProjectMember(projectId);
      allow create: if isProjectMemberBeforeOrAfter(projectId);
    }

    match /goalsMilestones/{projectId}/milestonesItems/{milestoneId} {
      allow read, write: if isProjectMember(projectId);
    }

    match /feedsObjectsLastStates/{projectId}/{objectType}/{objectId} {
      allow read, write: if isProjectMember(projectId);
    }

    match /notesCollab/{projectId}/notes/{noteId} {
      allow read, write: if canAccessObjectWhileProjectionIsPending(
        projectId,
        get(/databases/$(database)/documents/noteItems/$(projectId)/notes/$(noteId)).data
      );
    }

    // Client writes a lightweight marker; the scheduled revision-history
    // worker reads and deletes it through the Admin SDK.
    match /notesEditedDaily/{noteId} {
      allow create, update: if request.resource.data.projectId is string &&
        isProjectMember(request.resource.data.projectId);
      allow read, delete: if false;
    }

    // Legacy feed history is still produced by the client and consumed only by
    // trusted backend jobs. It must never be client-readable.
    match /oldFeeds/{projectId}/{document=**} {
      allow write: if isProjectMember(projectId);
      allow read: if false;
    }

    // security audit 2026-11 (NV-27): the create trigger mails the invitee in Alldone's name, naming
    // the inviter. The inviter is therefore bound to the writer, and the document carries only the
    // fields the app writes. The trigger builds the answer link itself and ignores `url`.
    function isValidProjectInvitation(data) {
      return data.keys().hasOnly(['userEmail', 'inviterId', 'userId', 'url']) &&
        data.get('inviterId', null) == request.auth.uid &&
        data.get('userEmail', null) is string &&
        data.userEmail.size() > 0 && data.userEmail.size() <= 320 &&
        (data.get('userId', null) == null || data.get('userId', null) is string) &&
        (data.get('url', null) == null || data.get('url', null) is string);
    }

    match /projectsInvitation/{projectId}/invitations/{invitationId} {
      allow read, delete: if isProjectMember(projectId);
      allow create: if isProjectMember(projectId) && isValidProjectInvitation(request.resource.data);
      allow update: if false;
    }

    match /events/{projectId}/rooms/{roomId} {
      allow read, write: if isProjectMember(projectId);
    }

    match /skillsDefaultPrivacy/{projectId}/items/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && isProjectMember(projectId);
    }

    match /tagsColors/{projectId}/{document=**} {
      allow read, write: if isProjectMember(projectId);
    }

    // security audit 2026-11 (NV-13): one marker per sticky note or topic, read only by the scheduled
    // demotion job (functions/StickyNotesHelper.js) through the Admin SDK. It used to be listable and
    // writable by every signed-in account, which leaked every tenant's project and note ids and let
    // anybody point the job at somebody else's note. A marker now belongs to the members of the
    // project it names, and nobody lists it. Deleting a marker that does not exist stays allowed:
    // the app untracks on every unstick, sticky or not.
    function isValidStickyNoteMarker(data) {
      return data.keys().hasOnly(['projectId', 'stickyEndDate']) &&
        data.get('projectId', null) is string && data.projectId != '' &&
        data.get('stickyEndDate', null) is number &&
        isProjectMember(data.projectId);
    }

    function canChangeStickyNoteMarker(data) {
      return data.get('projectId', null) is string && data.projectId != '' &&
        isProjectMember(data.projectId);
    }

    match /stickyNotesData/{noteId} {
      allow read: if false;
      allow create: if isValidStickyNoteMarker(request.resource.data);
      allow update: if isValidStickyNoteMarker(request.resource.data) && canChangeStickyNoteMarker(resource.data);
      allow delete: if signedIn() && (resource == null || canChangeStickyNoteMarker(resource.data));
    }

    match /runtimeErrors/{errorId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // security audit 2026-11 (NV-10): info/version is the release marker every open client watches
    // and reloads on. Only increaseVersionSecondGen writes it, through the Admin SDK.
    match /info/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /roles/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
