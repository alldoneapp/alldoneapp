# Image for the standalone webpack pipeline (web-bundler/, FRONTEND_MIGRATION_PLAN.md
# Stage 0). Two Node 22 dependency trees meet here:
# - /app/node_modules: the app's runtime dependencies from the root lockfile
# - /bundler/node_modules: webpack/babel tooling from web-bundler's lockfile
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS appdeps

FROM node:22-alpine

RUN apk --no-cache add git

WORKDIR /bundler
ADD web-bundler/package.json web-bundler/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY --from=appdeps /app/node_modules /app/node_modules
