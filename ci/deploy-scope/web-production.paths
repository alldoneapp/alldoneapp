# Paths whose change requires a new production web build + hosting deploy.
#
# Extended regular expressions, matched against `git diff --name-only` output with
# `grep -E -f`. Blank lines and # comments are stripped before use (a blank line in a
# grep pattern file matches EVERY path, which would mark every deploy as needed).
#
# This list MUST stay in sync with the `*web-relevant-paths` anchor in .gitlab-ci.yml,
# which still scopes the feature-branch jobs. __tests__/CiDeployScope.test.js fails the
# build if the two drift apart.
^\.gitlab-ci\.yml$
^App[^/]*\.js$
^index\.js$
^app\.json$
^babel\.config\.js$
^metro\.config\.js$
^webpack\.config\.js$
^tsconfig\.json$
^package\.json$
^package-lock\.json$
^\.npmrc$
^package-optimized-build-bundle\.json$
^firebase\.json$
^\.firebaserc$
^ci/Dockerfile_base$
^ci/github-push\.sh$
^ci/replace-envs\.sh$
^Themes/
^URLSystem/
^__mocks__/
^__tests__/
^apis/
^assets/
^components/
^hooks/
^i18n/
^redux/
^replacement_node_modules/
^utils/
^web/
^web-bundler/
^ci/Dockerfile_web_bundler$
