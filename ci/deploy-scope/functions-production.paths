# Broad Functions boundary retained for reference and guard coverage. Actual selection
# is computed by ci/selectFunctionsDeployment.js, including transitive imports outside
# functions/. This list alone must not be used to gate Functions deployments.
#
# firebase.json carries the functions runtime, region and ignore list, so a change there
# has to redeploy them too.
^functions/
^firebase\.json$
# Recheck the deployment when its completion guard changes, even if a previous
# partial deploy incorrectly advanced the marker to the current function sources.
^ci/assertFirebaseFunctionsDeployed\.js$
