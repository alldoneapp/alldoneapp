# Node 22 / npm 10 since migration Stage 5: the root lockfile is v3 and is
# maintained under Node 22 (see .nvmrc). .npmrc must be baked in — it carries
# legacy-peer-deps, without which npm 10 refuses the RN-era peer graph that
# npm 6 silently accepted. The expo-cli install is gone with the Node 14 pin:
# the legacy expo pipeline cannot run on this image and was local-only since
# Stage 0 flipped the deploys to web-bundler.
FROM node:22-alpine

WORKDIR /app

# The Firestore rules suite runs the official local emulator from this image.
# Keep Java in the dependency image instead of installing it during every CI job.
RUN apk --no-cache add git openjdk17-jre-headless

ADD package.json package-lock.json .npmrc ./

RUN npm ci
