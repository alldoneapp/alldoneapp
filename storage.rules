rules_version = '2';

// Storage rules for the DEFAULT bucket (<project>.appspot.com). Published through the Firebase
// Rules API, not by CI: firebase.json carries no storage target. See "Storage rules" in CLAUDE.md.
//
// The Admin SDK (every Cloud Function) is not bound by these rules, and neither is a download URL
// that carries its own token. These rules decide only what a BROWSER may do through the Storage
// SDK: put, getDownloadURL/getMetadata (get), listAll (list) and delete.
//
// Rules combine with OR, so every top-level folder is matched exactly once below. Anything not
// matched is denied: the folders Cloud Functions write (Invoice, anna-email-inbound,
// browserEvidence, whatsapp-images, assistantSkills, communit*...) are reached only through the
// Admin SDK or a token download URL, never through the client SDK.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function projectDoc(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId));
    }

    // Same authority as isProjectMember in firestore.rules: projects/{projectId}.userIds.
    function isProjectMember(projectId) {
      return signedIn() &&
        projectDoc(projectId).data.userIds is list &&
        request.auth.uid in projectDoc(projectId).data.userIds;
    }

    // Same as isPublicSharedProject in firestore.rules (2 = private). Signed-in only, as before.
    function isPublicSharedProject(projectId) {
      return signedIn() && projectDoc(projectId).data.get('isShared', 2) != 2;
    }

    // Note copies follow the note they copy, with the same helpers as storage.notes.rules. Cross-
    // service rules may read at most TWO Firestore documents per evaluation: the project and the
    // note.
    function noteExists(projectId, noteId) {
      return firestore.exists(/databases/(default)/documents/noteItems/$(projectId)/notes/$(noteId));
    }

    function note(projectId, noteId) {
      return firestore.get(/databases/(default)/documents/noteItems/$(projectId)/notes/$(noteId)).data;
    }

    // canAccessObjectWhileProjectionIsPending in firestore.rules.
    function canAccessNote(projectId, noteId) {
      return isProjectMember(projectId) && (
        request.auth.uid in note(projectId, noteId).get('readerIds', []) ||
        request.auth.uid in note(projectId, noteId).get('roleIdsVisibleTo', {}) ||
        request.auth.uid in note(projectId, noteId).get('backlinkIdsVisibleTo', {}) ||
        request.auth.uid in note(projectId, noteId).get('followedReaderIds', []) ||
        note(projectId, noteId).get('followedByVisibleTo', {}).get(request.auth.uid, false) == true ||
        (
          !('readerIds' in note(projectId, noteId)) &&
          !('roleIdsVisibleTo' in note(projectId, noteId)) &&
          !('followedByVisibleTo' in note(projectId, noteId)) &&
          !('followedReaderIds' in note(projectId, noteId)) &&
          !('backlinkIdsVisibleTo' in note(projectId, noteId)) &&
          note(projectId, noteId).get('isPublicFor', []).hasAny([0, request.auth.uid])
        )
      );
    }

    // canReadSharedObject in firestore.rules.
    function canReadSharedNote(projectId, noteId) {
      return isPublicSharedProject(projectId) && 0 in note(projectId, noteId).get('readerIds', []);
    }

    // A version copy follows its note and nothing else. Unlike the live body in the notes bucket
    // there is no missing-document fallback: copies outlive a deleted or moved note (the server
    // removes them a week later), and once the note document is gone so is its privacy decision.
    // Every client use of these paths (save a version, restore, daily copy) runs while the note
    // exists.
    function canUseNoteCopy(projectId, noteId) {
      return noteExists(projectId, noteId) && canAccessNote(projectId, noteId);
    }

    function canReadNoteCopy(projectId, noteId) {
      return noteExists(projectId, noteId) &&
        (canAccessNote(projectId, noteId) || canReadSharedNote(projectId, noteId));
    }

    // Uploads into the project-less attachment folders are bound to their uploader through custom
    // metadata that storeAttachment / storeConvertedVideos set on the put. A path alone (it is in
    // every shared download URL) must not let anybody else overwrite, delete or re-resolve the
    // object; everyone else reads it through the token URL the uploader shared. Only used under
    // `allow create`, which Storage evaluates exclusively for an object that does not exist yet (a
    // put over an existing one is an `update`), so a planted file can never replace somebody's.
    function isNewUploadByCaller() {
      return signedIn() && request.resource.metadata.get('uploaderId', null) == request.auth.uid;
    }

    function isCallersUpload() {
      return signedIn() && resource.metadata.get('uploaderId', null) == request.auth.uid;
    }

    // Same as isAdministrator in firestore.rules.
    function isAdministrator() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/roles/administrator).data.userId == request.auth.uid;
    }

    // Project artifacts: Cloud Functions write them, serveArtifact reads them behind the
    // artifact's rotatable serve secret. No client access at all.
    match /artifacts/{rest=**} {
      allow read, write: if false;
    }

    // Copies of note bodies (the live body is in the notes bucket, storage.notes.rules).
    match /noteVersionsData/{projectId}/{noteId}/{versionId} {
      allow get: if canReadNoteCopy(projectId, noteId);
      allow write: if canUseNoteCopy(projectId, noteId);
    }

    match /noteDailyVersionsData/{projectId}/{noteId} {
      allow get: if canReadNoteCopy(projectId, noteId);
      allow write: if canUseNoteCopy(projectId, noteId);
    }

    // Contact, assistant and feed avatars, uploaded under the project they belong to.
    match /projectsContacts/{projectId}/{rest=**} {
      allow read, write: if isProjectMember(projectId);
    }

    match /assistants/{projectId}/{rest=**} {
      allow read, write: if isProjectMember(projectId) ||
        (projectId == 'globalProject' && isAdministrator());
    }

    match /feeds/{projectId}/{rest=**} {
      allow read, write: if isProjectMember(projectId);
    }

    match /invoiceLogos/{projectId}/{userId}/{rest=**} {
      allow read, write: if request.auth.uid == userId && isProjectMember(projectId);
    }

    // Comment attachments: only the VM runner writes them (Admin SDK) and the chat links them by
    // token URL. No client code reads, lists or writes this folder, and a path carries no project,
    // so the client gets nothing here.
    match /attachments/{rest=**} {
      allow read, write: if false;
    }

    // Uploads into feeds and notes: date / random hash / file name, no project in the path. Only
    // the uploader may create (never over an existing object), resolve, replace or delete one.
    // No listing, so the random hash cannot be enumerated.
    match /feedAttachments/{rest=**} {
      allow create: if isNewUploadByCaller();
      allow get, delete: if isCallersUpload();
      allow update: if isCallersUpload() &&
        request.resource.metadata.get('uploaderId', null) == request.auth.uid;
    }

    match /notesAttachments/{rest=**} {
      allow create: if isNewUploadByCaller();
      allow get, delete: if isCallersUpload();
      allow update: if isCallersUpload() &&
        request.resource.metadata.get('uploaderId', null) == request.auth.uid;
    }

    // Customer invoices (Invoices.createPdf, Invoice/{uid}/{year} - {counter}.pdf): enumerable
    // names, mailed as signed URLs. Never a client path. Spelled out because it is the reason the
    // old "any signed-in user may get a server path" catch-all is gone.
    match /Invoice/{rest=**} {
      allow read, write: if false;
    }
  }
}
