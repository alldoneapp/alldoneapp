# Placeholder environment for the browser-test harnesses.
#
# `web-bundler/babel.config.js` runs react-native-dotenv with
# `allowUndefined: false`, so every name imported from 'react-native-dotenv'
# anywhere in the app source must EXIST here or Babel refuses to transform the
# file that imports it (utils/backends/firestore.js is on every harness's
# import graph via redux/store). Only the names matter: a harness renders
# components and measures the DOM, it never talks to Firebase, Algolia or
# Sentry.
#
# `browser-tests/babel.harness.js` uses the repository's real `.env` when one
# exists and falls back to this file otherwise, so a fresh checkout can run the
# harnesses without any secret material. Regenerate the list with:
#   node ci/writeTestEnv.js   (writes a root .env with the same names)
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_ONLY_API_KEY=
CURRENT_ENVIORNMENT=
GOOGLE_FIREBASE_STORAGE_BUCKET=
GOOGLE_FIREBASE_WEB_API_KEY=
GOOGLE_FIREBASE_WEB_APP_ID=
GOOGLE_FIREBASE_WEB_AUTH_DOMAIN=
GOOGLE_FIREBASE_WEB_CLIENT_ID=
GOOGLE_FIREBASE_WEB_DATABASE_URL=
GOOGLE_FIREBASE_WEB_MESSAGING_SENDER_ID=
GOOGLE_FIREBASE_WEB_NOTES_STORAGE_BUCKET=
GOOGLE_FIREBASE_WEB_PROJECT_ID=
HOSTING_URL=
NOTES_COLLABORATION_SERVER=
SENTRY_DSN=
